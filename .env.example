# ==========================================
# LIVEKIT CLOUD CREDENTIALS
# Get these from: https://cloud.livekit.io/
# ==========================================

# Your project URL (starts with wss://)
LIVEKIT_URL=wss://your-project.livekit.cloud

# API Key and Secret from Project Settings > Keys
LIVEKIT_API_KEY=APIabc123...
LIVEKIT_API_SECRET=secret...

# The LiveKit outbound SIP trunk that carries your calls.
# Create it with `lk sip outbound create` or in the LiveKit dashboard,
# then run `python setup_trunk.py` to sync the Vobiz credentials onto it.
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx


# ==========================================
# AI MODEL KEYS
# ==========================================

# OpenAI for LLM (Brain)
OPENAI_API_KEY=sk-...

# Deepgram for STT (Hearing)
DEEPGRAM_API_KEY=...

# Cartesia (optional) or OpenAI for TTS (Speaking)
# Set TTS_PROVIDER to "openai" or "cartesia"
TTS_PROVIDER=openai

# Optional TTS overrides. Defaults are shown.
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# Required only when TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=...
# CARTESIA_TTS_MODEL=sonic-2
# CARTESIA_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02


# ==========================================
# VOBIZ SIP TRUNK CONFIGURATION
# Get these from the Vobiz Console Platform: https://console.vobiz.ai/
# ==========================================

# The SIP Domain provided by Vobiz
VOBIZ_SIP_DOMAIN=your_sip_domain.sip.vobiz.ai

# Your SIP Username
VOBIZ_USERNAME=your_username

# Your SIP Password
VOBIZ_PASSWORD=your_password

# Your DID (Phone Number) for outbound calls
# Must be in E.164 format, including the country code
VOBIZ_OUTBOUND_NUMBER=+15550003333

# Default number the transfer_call tool dials when the caller does not name one
DEFAULT_TRANSFER_NUMBER=+15550003333
