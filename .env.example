# LiveKit project: https://cloud.livekit.io
# The agent's speech and language models run on LiveKit Inference, so these are the only AI keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Vobiz outbound trunk: https://console.vobiz.ai
VOBIZ_SIP_DOMAIN=your_trunk_id.sip.vobiz.ai
VOBIZ_USERNAME=your_sip_username
VOBIZ_PASSWORD=your_sip_password

# The Vobiz number used as caller ID, in E.164 format.
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

# Printed by setup_trunk.py.
SIP_OUTBOUND_TRUNK_ID=
